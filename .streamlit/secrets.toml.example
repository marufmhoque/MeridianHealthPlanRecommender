# Copy these into Streamlit Community Cloud -> App settings -> Secrets.
# Both are optional: without them the app runs fully offline in deterministic mode.
# Never commit a real secrets.toml.

ANTHROPIC_API_KEY = "sk-ant-..."   # Claude extraction + tool-calling cost planning

# OPENAI_API_KEY = "sk-..."        # only used if you also add `openai` to requirements.txt
# MERIDIAN_CLAUDE_MODEL = "claude-opus-5-5"
# MERIDIAN_CLAUDE_EFFORT = "low"
# MERIDIAN_DISABLE_LLM = "1"       # force deterministic mode even with a key set
# Do not set MERIDIAN_REVIEW_DATE on the cloud: it pins the review date instead of using today.
