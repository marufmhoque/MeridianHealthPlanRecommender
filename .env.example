# All optional. Without API keys the assistant runs fully offline and deterministically.

# Enables Claude for clinical extraction and tool-calling cost planning
ANTHROPIC_API_KEY=
MERIDIAN_CLAUDE_MODEL=claude-opus-5-5
MERIDIAN_CLAUDE_EFFORT=low

# Enables text-embedding-3-small for policy embeddings (also: pip install openai)
OPENAI_API_KEY=

# Pin the review date for reproducible 30-day note checks (defaults to today)
MERIDIAN_REVIEW_DATE=2026-11-06

# Set to 1 to force deterministic mode even when a key is present
MERIDIAN_DISABLE_LLM=
